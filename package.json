{
  "name": "mercon",
  "version": "1.0.0",
  "private": true,
  "description": "MERCON Logistics — monorepo (API server, web dashboard, shared types). Mobile apps are a separate npm workspace in frontend/mobile-app.",
  "workspaces": [
    "packages/*",
    "backend/api-server",
    "frontend/web-dashboard"
  ],
  "scripts": {
    "dev": "npx --yes concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @mercon/api-server",
    "dev:web": "npm run dev -w @mercon/web-dashboard",
    "build:types": "npm run build -w @mercon/shared-types",
    "postinstall": "npm run build:types || true",
    "build": "npm run build:types && npm run build -w @mercon/api-server && npm run build -w @mercon/web-dashboard",
    "seed": "npm run seed -w @mercon/api-server",
    "mobile:driver": "npm --prefix frontend/mobile-app/driver-app run start",
    "mobile:operator": "npm --prefix frontend/mobile-app/operator-app run start",
    "mobile:driver:tunnel": "npm --prefix frontend/mobile-app/driver-app run start -- --tunnel",
    "mobile:operator:tunnel": "npm --prefix frontend/mobile-app/operator-app run start -- --tunnel"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "localtunnel": "^2.0.2"
  }
}
