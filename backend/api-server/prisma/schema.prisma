generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// ENUMS (Strict State Machines)
// -----------------------------------------
enum Role {
  SuperAdmin
  Admin
  Operator
  Driver
}

enum DriverStatus {
  Available
  OnTrip
  OffDuty
  Inactive
}

enum AssetStatus {
  Available
  OnTrip
  Maintenance
  Inactive
}

enum AssetType {
  Flatbed
  Reefer
  Box
  Tanker
}

enum DriverWorkflow {
  NATIVE
  EXTERNAL_APP
}

enum TripStatus {
  Scheduled
  Loading
  InTransit
  Delayed
  Completed
  Invoiced
  Cancelled
  Draft
}

enum StopType {
  Pickup
  Dropoff
  Rest
  Refuel
}

enum CoordinatePrecision {
  EXACT
  APPROXIMATE
  UNKNOWN
}

enum DocType {
  DriverLicense
  VehicleRegistration
  Insurance
  POD
  CustomsClearance
  Waybill
  Contract
  Invoice
  Emergency
  Passport
}

enum DocStatus {
  PendingReview
  Verified
  Rejected
  Expired
}

// Who a DocumentType's slots apply to. Mirrors the polymorphic
// Document.entity_type strings but as a real enum, since DocumentType rows
// are configuration (must validate cleanly), not free-form data like
// Document.entity_type still is.
enum DocOwnerType {
  Driver
  Vehicle
  Trip
  Customer
  Company
  Other
}

// Whether a DocumentType's slot must be filled for its owner to be
// "compliant". DISABLED keeps a retired type's history queryable without it
// counting toward compliance or appearing in upload pickers.
enum DocRequirement {
  MANDATORY
  OPTIONAL
  DISABLED
}

/// Why a stop was reached late. Logged by an operator, never by the driver:
/// drivers already report the cause in the WhatsApp group (usually with a
/// photo), and asking them to classify it in the app is training cost for
/// something the office already knows. Traffic dominates in practice.
enum DelayReason {
  Traffic
  VehicleBreakdown
  CustomerNotReady
  SlowLoadingUnloading
  Weather
  Documentation
  RouteBlocked
  Other
}

enum AssignmentType {
  PRIMARY
  BACKUP
  TEMPORARY
}

enum DriverTripRole {
  PRIMARY
  CO_DRIVER
  RELIEVER
}

enum AssignmentEntityType {
  DRIVER
  VEHICLE
}

// -----------------------------------------
// 1. ORGANIZATION (Simplified)
// -----------------------------------------
model User {
  id            String  @id @default(uuid()) @db.Uuid
  username      String  @unique
  email         String? @unique
  phone         String? @unique
  password_hash String?
  name          String?
  role          Role    @default(Operator)

  // Platform-level flag, orthogonal to `role`. A superadmin is an Admin who
  // can also edit this deployment's branding/module config (see Settings
  // below). Deliberately NOT a 4th Role value — see CLAUDE.md's "exactly
  // three roles" rule.
  isSuperAdmin Boolean @default(false)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  verifiedDocs         Document[]            @relation("VerifiedBy")
  driver               Driver?
  notifications        Notification[]
  tripStopDelayLogs    TripStop[]            @relation("TripStopDelayLogger")
  tripAssignmentEvents TripAssignmentEvent[]
  quotationHistories   QuotationHistory[]
  auditLogs            AuditLog[]
}

model Customer {
  id                       String  @id @default(uuid()) @db.Uuid
  name                     String
  contact_phone            String
  logo_url                 String?
  primary_contact_person   String?
  primary_contact_phone    String?
  secondary_contact_person String?
  secondary_contact_phone  String?
  payment_terms            String?
  whatsapp_number          String?
  whatsapp_group_link      String?
  whatsapp_group_name      String?

  driver_workflow DriverWorkflow @default(NATIVE)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  trips           Trip[]
  quotations      Quotation[]
  surchargeRules  SurchargeRule[]
  reportTemplates ReportTemplate[]
  locations       Location[]
  invoices        Invoice[]

  // Every customer list and picker filters on deletedAt.
  @@index([deletedAt])
}

// -----------------------------------------
// 2. FLEET MANAGEMENT (Merged Vehicle/Trailer)
// -----------------------------------------
model Driver {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String?      @unique @db.Uuid
  user           User?        @relation(fields: [userId], references: [id])
  ref_id         String?      @unique
  first_name     String
  last_name      String
  phone_primary  String?      @unique
  status         DriverStatus @default(Available)
  license_number String
  license_expiry DateTime     @db.Timestamptz
  avatar_url     String?

  // The vehicle this driver normally drives, set from the Drivers module.
  // Trip creation pre-fills this as the trip's vehicle so dispatchers don't
  // re-pick it every time — it can still be overridden per trip.
  assignedVehicleId String?  @unique @db.Uuid
  assignedVehicle   Vehicle? @relation("DriverAssignedVehicle", fields: [assignedVehicleId], references: [id])

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  trips              Trip[]                    @relation("TripPrimaryDriver")
  coTrips            Trip[]                    @relation("TripCoDriver")
  originalTrips      Trip[]                    @relation("TripOriginalDriver")
  vehicleAssignments DriverVehicleAssignment[]
  notifications      Notification[]
  devices            DriverDevice[]
  expenses           Expense[]
  executedTripStops  TripStop[]                @relation("TripStopExecutorDriver")
  executedDocuments  Document[]                @relation("DocumentExecutorDriver")

  @@index([status, deletedAt])
  @@index([deletedAt])
  @@index([license_expiry])
  @@index([first_name, last_name])
  @@index([deletedAt, license_expiry])
  @@index([deletedAt, createdAt])
}

model DriverVehicleAssignment {
  id        String  @id @default(uuid()) @db.Uuid
  driverId  String  @db.Uuid
  driver    Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  assignmentType AssignmentType @default(PRIMARY)
  priority       Int            @default(1)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime? @db.Timestamptz
  effectiveTo   DateTime? @db.Timestamptz

  notes      String?  @db.Text
  created_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([driverId, vehicleId, assignmentType])
  @@index([driverId, isActive])
  @@index([vehicleId, isActive])
}

model Vehicle {
  id                  String      @id @default(uuid()) @db.Uuid
  ref_id              String?     @unique
  plate_number        String      @unique
  asset_type          AssetType
  status              AssetStatus @default(Available)
  capacity_kg         Int
  current_odometer    Float       @default(0.0)
  // When current_odometer was last changed — drives the "reading is stale,
  // ask the operator to update it" prompt. Null means never recorded.
  odometer_updated_at DateTime?   @db.Timestamptz
  image_url           String?
  last_lat            Float?
  last_lng            Float?

  // Trailer Information Merged
  trailer_number      String?
  trailer_type        AssetType?
  trailer_capacity_kg Int?

  // Third-Party Tracking
  icces_device_id String? @unique

  // Latest known telemetry, overwritten by the ICCES poller. Only the current
  // position is kept — there is no history table, so this answers "where is it
  // now?" and cannot answer "where was it yesterday?".
  //
  // All nullable, and deliberately so: a vehicle with no tracker, or one whose
  // tracker has never reported, must be distinguishable from one genuinely
  // sitting still at 0 km/h. Defaulting these to 0 would invent telemetry.
  //
  // `last_seen_at` is the one that matters most operationally: it is when the
  // DEVICE reported, not when MERCON polled. Without it a tracker that died
  // four hours ago looks exactly like a truck parked four hours ago — the
  // fleet already contains such a device (DEVICE_NOT_WORKING, last report
  // 4h22m stale) so this is not hypothetical.
  last_speed_kph Float?
  last_heading   Float?
  last_status    String?
  last_seen_at   DateTime? @db.Timestamptz

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  trips              Trip[]
  originalTrips      Trip[]                    @relation("TripOriginalVehicle")
  maintenanceRecords MaintenanceRecord[]
  expenses           Expense[]
  assignedDriver     Driver?                   @relation("DriverAssignedVehicle")
  driverAssignments  DriverVehicleAssignment[]

  @@index([status, deletedAt])
  @@index([deletedAt])
}

// -----------------------------------------
// 3. LOGISTICS ENGINE (Trips & Payments)
// -----------------------------------------
model Trip {
  id               String   @id @default(uuid()) @db.Uuid
  ref_id           String?  @unique
  awb_number       String?
  customerId       String   @db.Uuid
  customer         Customer @relation(fields: [customerId], references: [id])
  driverId         String?  @db.Uuid
  driver           Driver?  @relation("TripPrimaryDriver", fields: [driverId], references: [id])
  co_driver_id     String?  @db.Uuid
  co_driver_payout Decimal  @default(0.0) @db.Decimal(12, 2)
  coDriver         Driver?  @relation("TripCoDriver", fields: [co_driver_id], references: [id])
  vehicleId        String?  @db.Uuid
  vehicle          Vehicle? @relation(fields: [vehicleId], references: [id])

  // Contingency & Replacement Audit Summary
  is_contingency_dispatch Boolean  @default(false)
  original_vehicle_id     String?  @db.Uuid
  originalVehicle         Vehicle? @relation("TripOriginalVehicle", fields: [original_vehicle_id], references: [id])
  original_driver_id      String?  @db.Uuid
  originalDriver          Driver?  @relation("TripOriginalDriver", fields: [original_driver_id], references: [id])
  contingency_reason      String?  @db.Text

  // Replacement Audit Log Events
  assignmentEvents TripAssignmentEvent[]

  // Which quotation the billing amount came from, recorded at dispatch.
  quotationId String?    @db.Uuid
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  // Dedicated 1-to-1 Commercial Financials Snapshot
  financials TripFinancials?

  vehicle_type   String?
  rate_category  String?
  operation_type String?

  status                TripStatus     @default(Scheduled)
  driver_workflow_state String?
  driver_workflow       DriverWorkflow @default(NATIVE)
  planned_distance      Float?

  planned_start DateTime? @db.Timestamptz
  actual_start  DateTime? @db.Timestamptz
  planned_end   DateTime? @db.Timestamptz
  actual_end    DateTime? @db.Timestamptz

  // Post-Trip Financial & Ledger Fields
  //
  // What MERCON pays out for this trip (own driver, or the subcontractor when
  // is_third_party). A cost, not revenue — deliberately excluded from the
  // customer invoice total.
  driver_payout        Decimal  @default(0.0) @map("driver_payout") @db.Decimal(12, 2)
  billing_amount       Decimal? @db.Decimal(12, 2)
  paid_amount          Decimal  @default(0.0) @db.Decimal(12, 2)
  balance_due          Decimal? @db.Decimal(12, 2)
  // No DB-level default — set from Settings.companyLegalName at create time
  // (see tripController.ts / getCompanyLegalName), since a hardcoded literal
  // here can't vary per deployment.
  carrier_name         String?
  is_post_trip_settled Boolean  @default(false)

  // Third-Party / Rental Carrier Details
  is_third_party Boolean          @default(false)
  subcontract    TripSubcontract?

  // Invoice / Accounts Receivable Link
  invoiceId String?   @db.Uuid
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id])
  invoiceLines InvoiceLine[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  stops     TripStop[]
  // Itemised customer-billable extras for this trip. The trip's total bill is
  // billing_amount plus the sum of these.
  charges   TripCharge[]
  locations TripLocation[]

  @@index([vehicleId, driverId])
  @@index([is_third_party])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([planned_start])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@index([customerId, status, deletedAt])
  @@index([driverId, deletedAt])
  @@index([vehicleId, deletedAt])
  @@index([driverId, status, deletedAt])
  @@index([co_driver_id, status, deletedAt])
}

model TripAssignmentEvent {
  id            String               @id @default(uuid()) @db.Uuid
  tripId        String               @db.Uuid
  trip          Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  entityType    AssignmentEntityType
  fromId        String?              @db.Uuid
  toId          String?              @db.Uuid
  reason        String               @db.Text
  changedBy     String?              @db.Uuid
  changedByUser User?                @relation(fields: [changedBy], references: [id])
  changedAt     DateTime             @default(now()) @db.Timestamptz

  @@index([tripId])
}

// Dedicated 1-to-1 Commercial Financials Snapshot Entity
model TripFinancials {
  id                             String     @id @default(uuid()) @db.Uuid
  tripId                         String     @unique @db.Uuid
  trip                           Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  quotationId                    String?    @db.Uuid
  quotation                      Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  applied_rate                   Decimal?   @db.Decimal(12, 2)
  quotation_line_type            String?
  quotation_operation_type       String?
  quotation_pricing_basis        String?
  quotation_vehicle_class        String?
  quotation_source_vehicle_label String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([quotationId])
}

// -----------------------------------------
// 2B. THIRD-PARTY LOGISTICS (Subcontractors & Rental Fleet)
// -----------------------------------------
model ThirdPartyProvider {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @unique
  contact_person String?
  phone          String?
  email          String?
  address        String? @db.Text
  tax_id         String?
  rating         Float   @default(5.0)
  notes          String? @db.Text

  subcontracts      TripSubcontract[]
  providerRateCards ProviderRateCard[]
  bills             Bill[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  @@index([deletedAt])
}

model TripSubcontract {
  id           String              @id @default(uuid()) @db.Uuid
  tripId       String              @unique @db.Uuid
  trip         Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  providerId   String?             @db.Uuid
  provider     ThirdPartyProvider? @relation(fields: [providerId], references: [id])
  driverName   String?
  driverPhone  String?
  vehiclePlate String?
  vehicleType  String?
  cost         Decimal?            @default(0.0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now()) @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @db.Timestamptz

  @@index([providerId])
}

model ProviderRateCard {
  id         String             @id @default(uuid()) @db.Uuid
  providerId String             @db.Uuid
  provider   ThirdPartyProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Canonical Lane Corridor
  origin_city           String
  destination_city      String
  originLocationId      String?   @db.Uuid
  originLocation        Location? @relation("ProviderRateOriginLocation", fields: [originLocationId], references: [id], onDelete: SetNull)
  destinationLocationId String?   @db.Uuid
  destinationLocation   Location? @relation("ProviderRateDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: SetNull)

  // Rate Taxonomy
  vehicle_class  String // "10 TON", "20 TON", "40 FEET", "3-4 TON", "5 TON"
  line_type      String // "Single Trip", "Round Trip", "10 Hours Duty", "12 Hours Duty"
  operation_type String? // "Extra", "Monthly", or NULL (Applies to both)
  pricing_basis  String  @default("Per Trip") // "Per Trip" vs "Per Month"

  // Commercial Subcontract Cost
  cost Decimal @db.Decimal(12, 2) // Agreed baseline cost paid to provider

  // Validity & Lifecycle Status
  valid_from DateTime? @db.Timestamptz
  valid_to   DateTime? @db.Timestamptz
  status     String    @default("active") // "active", "expired", "archived"

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz

  @@index([providerId])
  @@index([origin_city, destination_city, vehicle_class, line_type, pricing_basis])
  @@index([status, deletedAt])
}

model TripStop {
  id                            String               @id @default(uuid()) @db.Uuid
  tripId                        String               @db.Uuid
  trip                          Trip                 @relation(fields: [tripId], references: [id])
  stop_sequence                 Int
  leg_index                     Int                  @default(0)
  stop_type                     StopType
  location_lat                  Float?
  location_lng                  Float?
  location_coordinate_precision CoordinatePrecision?
  // What people call this place — "Khamis Sorting Center". Coordinates
  // identify a stop but cannot be read: a delay report grouped by raw lat/lng
  // has one row per pin dropped rather than one per real destination, so the
  // same site never accumulates a history. Free text, because these are the
  // customer's yards and depots, not a list we own.
  location_name                 String?
  // The full postal address of this stop, as returned by the address search.
  // location_name is the short label a report groups by ("Khamis Sorting
  // Center"); this is what a driver actually needs to find the place, and what
  // gets handed to a navigation app. Kept separate because truncating the
  // address down to a label is lossy and cannot be reversed.
  location_address              String?              @db.Text
  // The lane endpoint this stop belongs to ("Riyadh"), as opposed to the exact
  // yard within it that location_name/lat/lng describe. This is what makes a
  // trip's lane recoverable after the fact, and what the rate lookup keys on.
  locationId                    String?              @db.Uuid
  location                      Location?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  planned_arrival               DateTime?            @db.Timestamptz
  actual_arrival                DateTime?            @db.Timestamptz
  // When the driver left this stop. Paired with actual_arrival this is how
  // long they were held here — the difference between "arrived late" and
  // "arrived on time but waited three hours to be unloaded", which the two
  // are indistinguishable without it. Stamped by stampStopTransition().
  actual_departure              DateTime?            @db.Timestamptz

  // Why this stop was late, filled in by an operator after the fact. Null on
  // a late stop means nobody has explained it yet — that is what the report's
  // "needs a reason" flag and the operator alert are driven from, so it must
  // stay distinguishable from Other.
  delay_reason         DelayReason?
  delay_note           String?      @db.Text
  delay_logged_by      String?      @db.Uuid
  delay_logged_by_user User?        @relation("TripStopDelayLogger", fields: [delay_logged_by], references: [id])
  delay_logged_at      DateTime?    @db.Timestamptz
  executorDriverId     String?      @db.Uuid
  executorDriver       Driver?      @relation("TripStopExecutorDriver", fields: [executorDriverId], references: [id])

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz

  // Postgres does not index foreign keys automatically and Prisma does not
  // declare them, so loading a trip's stops scanned the whole table — on
  // every trip of every trip list.
  @@index([tripId])
  @@index([tripId, leg_index])
  @@index([tripId, stop_sequence])
}

model TripLocation {
  id         String   @id @default(uuid()) @db.Uuid
  tripId     String   @db.Uuid
  trip       Trip     @relation(fields: [tripId], references: [id])
  lat        Float
  lng        Float
  speed_kph  Float?
  heading    Float?
  accuracy_m Float?
  recordedAt DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([tripId, recordedAt])
}

// -----------------------------------------
// 4. ENTERPRISE DMS (Document Management)
// -----------------------------------------
model Folder {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  category    String? // "Drivers", "Vehicles", "Operations", "Company", or custom
  description String? @db.Text
  color       String? @default("#E8450F")

  documents Document[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)

  @@index([deletedAt])
}

// Database-driven document requirement configuration (replaces hardcoding
// "a Driver needs exactly 4 documents" in code). Seeded with Mercon's current
// requirements in seed.ts, but editable from /settings/document-types without
// a deploy — see PROGRESS.md for the Documents Center redesign this backs.
model DocumentType {
  id                String         @id @default(uuid()) @db.Uuid
  code              String         @unique
  name              String
  description       String?        @db.Text
  ownerType         DocOwnerType
  requirementStatus DocRequirement @default(OPTIONAL)
  isActive          Boolean        @default(true)
  displayOrder      Int            @default(0)

  requiresIssueDate   Boolean  @default(false)
  requiresExpiryDate  Boolean  @default(true)
  allowsMultipleFiles Boolean  @default(false)
  allowedFileTypes    String[] @default([])

  documents   Document[]
  importItems DocumentImportItem[]

  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([ownerType, isActive])
}

model Document {
  id          String    @id @default(uuid()) @db.Uuid
  entity_type String // "Driver", "Vehicle", "Trip", "MaintenanceRecord", "Customer", "Company"
  entity_id   String    @db.Uuid
  doc_type    DocType?
  status      DocStatus @default(PendingReview)

  // The document's configured type — supersedes doc_type as the source of
  // truth for what this document *is* (mandatory/optional, expiry rules,
  // display name). doc_type is kept and still written for back-compat with
  // any external/legacy readers; nullable because pre-existing rows are
  // backfilled by seed.ts rather than migrated in a single destructive pass.
  documentTypeId String?       @db.Uuid
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id])

  file_url  String
  mime_type String?
  checksum  String?

  folderId String? @db.Uuid
  folder   Folder? @relation(fields: [folderId], references: [id])

  issue_date  DateTime? @db.Timestamptz
  expiry_date DateTime? @db.Timestamptz

  ocr_raw_text      String? @db.Text
  ai_extracted_json Json?   @db.JsonB
  is_confidential   Boolean @default(false)

  verified_by      String? @db.Uuid
  verifier         User?   @relation("VerifiedBy", fields: [verified_by], references: [id])
  executorDriverId String? @db.Uuid
  executorDriver   Driver? @relation("DocumentExecutorDriver", fields: [executorDriverId], references: [id])

  files DocumentFile[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  @@index([documentTypeId])
  // Documents are looked up by their polymorphic owner — this is the index
  // behind every driver/vehicle document folder.
  @@index([entity_type, entity_id, deletedAt])
  // The Documents Center list: live rows, newest first.
  @@index([deletedAt, createdAt])
  // Expiry radar / renewal reminders.
  @@index([deletedAt, expiry_date])
  @@index([folderId])
}

// One physical file belonging to a Document. Document.file_url/mime_type
// remain the primary/first file for back-compat with existing readers
// (OCR service, bulk-download, mobile) that read those fields directly;
// additional files (e.g. IQAMA front+back) only exist here.
model DocumentFile {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @db.Uuid
  document     Document @relation(fields: [documentId], references: [id])
  file_url     String
  mime_type    String?
  label        String?
  displayOrder Int      @default(0)

  created_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)

  @@index([documentId])
}

// A batch of uploaded files that have not become Documents yet.
//
// Uploads used to write a Document row immediately and rely on a separate
// "auto-assign" pass to work out its owner afterwards — which is why
// unowned documents piled up in the vault as a permanent state. Files now
// land here first, get read by AI, and only become real Documents once a
// human confirms the proposal. An abandoned import is therefore just an
// unfinished import, never clutter inside /documents.
model DocumentImport {
  id    String               @id @default(uuid()) @db.Uuid
  items DocumentImportItem[]

  created_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)

  @@index([created_by, isActive])
}

enum ImportItemStatus {
  Pending // uploaded, awaiting manual or AI analysis
  Analyzing // queued for / undergoing AI extraction
  Ready // has a proposal the user can accept as-is
  NeedsInput // a fleet document, but owner and/or type still unclear
  // Read successfully and is simply not a document this system tracks — a
  // bank statement, a screenshot, someone's holiday photo. Kept apart from
  // NeedsInput because the answer is "this doesn't belong here", not "tell me
  // which driver owns it"; the review table can bulk-dismiss these.
  Unrecognised
  Confirmed // written out to a real Document
  Skipped // user explicitly dropped this file
  Failed // file could not be read at all (corrupt/empty/unsupported)
}

model DocumentImportItem {
  id       String         @id @default(uuid()) @db.Uuid
  importId String         @db.Uuid
  import   DocumentImport @relation(fields: [importId], references: [id])

  original_filename String
  file_url          String
  mime_type         String?

  status ImportItemStatus @default(Analyzing)

  // What the AI + matcher believe this file is. All nullable: an unmatched
  // file is a legitimate outcome that the user resolves in the review table,
  // never a guess written as if it were certain.
  proposed_owner_type       String?
  proposed_owner_id         String?       @db.Uuid
  proposed_document_type_id String?       @db.Uuid
  proposedDocumentType      DocumentType? @relation(fields: [proposed_document_type_id], references: [id])
  match_confidence          String? // HIGH | MEDIUM | LOW | NONE
  match_reason              String? // human-readable: "plate 1234 ABC found in document"

  // Plain-language description of what the AI saw, always populated even when
  // the document matches no configured type — so an out-of-scope file can be
  // reported as "appears to be a bank statement" rather than the useless
  // "could not determine the document type".
  detected_kind String?

  document_number   String?
  issue_date        DateTime? @db.Timestamptz
  expiry_date       DateTime? @db.Timestamptz
  issuing_authority String?
  ai_extracted_json Json?     @db.JsonB
  ocr_raw_text      String?   @db.Text

  // Set when the proposed owner+type slot is already filled by a live
  // document, so the review table can offer Replace / Add file / Skip
  // instead of silently creating a duplicate.
  duplicate_of_document_id String? @db.Uuid

  error_message     String?
  createdDocumentId String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([importId, status])
}

// -----------------------------------------
// 5. MAINTENANCE (External Workflow)
// -----------------------------------------
model MaintenanceRecord {
