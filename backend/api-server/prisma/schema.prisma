// -----------------------------------------
// 6. FINANCIALS (Expenses & Payouts)
// -----------------------------------------

// General operating expenses — salaries, fuel, rent, and any other outgoing
// cost that isn't a vehicle service order (MaintenanceRecord already covers
// those). Optionally tied to a Driver (salary/advance) or Vehicle (fuel/toll)
// so those costs can be filtered per driver or per vehicle, but neither link
// is required — plenty of expenses (rent, office supplies) are neither.
model Expense {
  id     String  @id @default(uuid()) @db.Uuid
  ref_id String? @unique

  // Free text like RateCard.vehicle_type, not a Postgres enum: the category
  // list evolves with the business and an unrecognised legacy value must
  // never break a deploy.
  category String
  status   String @default("Paid")

  driverId  String?  @db.Uuid
  driver    Driver?  @relation(fields: [driverId], references: [id])
  vehicleId String?  @db.Uuid
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  payee          String?
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @default("SAR")
  expense_date   DateTime @db.Timestamptz
  payment_method String?
  description    String?  @db.Text

  // When the vendor's bill was issued, and when it was actually paid —
  // distinct from expense_date, which is when the expense was logged.
  // Both nullable: known upfront for a Pending expense is just the issue
  // date, if that; the paid date only exists once it's settled.
  bill_issued_date DateTime? @db.Timestamptz
  bill_paid_date   DateTime? @db.Timestamptz

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  @@index([deletedAt])
  @@index([category])
  @@index([expense_date])
  @@index([driverId])
  @@index([vehicleId])
}

// -----------------------------------------
// 7. PRICING & QUOTATIONS (Quotations)
// -----------------------------------------
model Quotation {
  id               String   @id @default(uuid()) @db.Uuid
  quotation_number Int?     @default(autoincrement())
  name             String
  line_type        String?
  operation_type   String?
  pricing_basis    String?
  rate             Decimal  @db.Decimal(12, 2)
  driver_payout    Decimal? @db.Decimal(12, 2)
  currency         String   @default("SAR")

  vehicle_class        String?
  source_vehicle_label String?

  stops QuotationStop[]

  valid_from DateTime? @db.Timestamptz
  valid_to   DateTime? @db.Timestamptz

  source_type      String?
  source_reference String?

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  trips          Trip[]
  tripFinancials TripFinancials[]
  surchargeRules SurchargeRule[]
  priceHistory   QuotationHistory[]

  is_active Boolean @default(true)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  version    Int       @default(1)

  @@index([customerId])
  @@index([quotation_number])
  @@index([deletedAt])
}

model QuotationStop {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  sequence   Int
  leg_index  Int       @default(0)
  locationId String?   @db.Uuid
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)

  stop_type    StopType
  source_label String?

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([quotationId])
  @@index([quotationId, leg_index])
  @@index([locationId])
}

model QuotationHistory {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  old_rate          Decimal? @db.Decimal(12, 2)
  new_rate          Decimal? @db.Decimal(12, 2)
  old_driver_payout Decimal? @db.Decimal(12, 2)
  new_driver_payout Decimal? @db.Decimal(12, 2)

  changed_by         String?
  changed_by_user_id String? @db.Uuid
  changed_by_user    User?   @relation(fields: [changed_by_user_id], references: [id])
  changed_by_name    String?

  reason  String?
  source  String  @default("QUOTATION_MODULE")
  trip_id String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([quotationId])
  @@index([createdAt])
}

// -----------------------------------------
// 7B. SURCHARGES (Customer Fee Schedules & Applied Trip Charges)
// -----------------------------------------
// One line of a customer's standing fee schedule — "AKS charges per additional
// stop", "HORIZON charges per labourer". Set up once from the Rate Cards page,
// then applied to individual trips at settlement (see TripCharge).
//
// This exists because the two fields it replaces (Trip.waiting_labor_charges
// and Trip.additional_stop_charges) were flat numbers typed by hand with no
// link to anything the customer had actually agreed to, and there are only two
// of them — the real quotations carry six or more distinct fee types per
// customer (additional stop, waiting/labour, labour per person, offloading per
// vehicle, same-day delivery, trolley), so two fixed columns could never hold
// them.
model SurchargeRule {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id])

  // Null means the fee applies to every lane this customer books — which is
  // how most of them are actually written ("additional stops on the same
  // route, 100 SAR per stop" isn't tied to a route). Set means the fee only
  // applies on that one lane, and the lane's origin/destination come from the
  // rate card rather than being duplicated here.
  quotationId String?    @db.Uuid
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  // Free text, not an enum, for the same reason RateCard.vehicle_type is free
  // text: each customer's quotation names its own fees and there is no shared
  // list to validate against. Previously-entered values are offered back as
  // suggestions by the frontend (see getDistinctChargeTypes), which is what
  // makes them reusable without constraining them.
  charge_type String
  // What quantity this rule is counted in — "per stop", "per hour", "per
  // person". A label only: nothing computes from it, but settlement needs it
  // to ask the right question when a quantity is entered.
  unit        String?

  // Some fees are quoted per vehicle tier (an offloading fee that differs for
  // a 3-ton and a 40-foot). Null means the fee applies regardless of vehicle.
  vehicle_type String?

  rate     Decimal @db.Decimal(12, 2)
  currency String  @default("SAR")

  // Soft on/off, matching RateCard.is_active. There is deliberately no
  // effective-dating here: a renegotiated rate replaces the old one, and past
  // trips keep their own frozen copy of what was charged (see TripCharge), so
  // history survives without versioning this table.
  is_active Boolean @default(true)

  tripCharges TripCharge[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  version    Int       @default(1)

  @@index([customerId, quotationId])
  @@index([deletedAt])
}

// One customer-billable extra actually charged on one trip — "2 additional
// stops at 200 SAR = 400 SAR". A trip has zero or more of these, and its total
// bill is billing_amount plus the sum of them.
//
// charge_type / unit / rate are DENORMALISED COPIES of the SurchargeRule as it
// stood when the charge was applied, for the same reason Trip.vehicle_type and
// RateCard.route_origin are denormalised: editing or deleting the rule later
// must never retroactively change what a past trip was charged. surchargeRuleId
// records where the numbers came from; it is not where they are read from.
model TripCharge {
  id String @id @default(uuid()) @db.Uuid

  tripId String @db.Uuid
  trip   Trip   @relation(fields: [tripId], references: [id])

  // Null means a one-off charge typed at settlement that isn't in any saved
  // fee schedule — and also covers the rows migrated off the old
  // waiting_labor_charges / additional_stop_charges columns, which predate
  // there being any rule to point at.
  surchargeRuleId String?        @db.Uuid
  surchargeRule   SurchargeRule? @relation(fields: [surchargeRuleId], references: [id])

  charge_type String
  unit        String?
  rate        Decimal @db.Decimal(12, 2)
  quantity    Float
  // quantity * rate by default, but stored rather than computed so it stays
  // independently editable — settlement lets an operator override the final
  // number, the same way every other financial field on Trip can be.
  amount      Decimal @db.Decimal(12, 2)

  // No soft-delete fields, unlike the audited business records elsewhere in
  // this schema: a charge line is corrected by removing it and adding the
  // right one, and the Trip it hangs off is already soft-deletable.
  created_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([tripId])
  @@index([surchargeRuleId])
}

// -----------------------------------------
// ACCOUNTING / GENERAL LEDGER FOUNDATION
// -----------------------------------------

enum AccountType {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

enum CashFlowCategory {
  Operating
  Investing
  Financing
}

model Account {
  id                 String            @id @default(uuid()) @db.Uuid
  account_code       String            @unique
  name               String
  account_type       AccountType
  cash_flow_category CashFlowCategory?

  parentId String?   @db.Uuid
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  description String? @db.Text
  is_postable Boolean @default(true)

  journalLines JournalLine[]
  invoicePayments InvoicePayment[]
  billPayments BillPayment[]
  billLines BillLine[]
  bankAccount BankAccount?
  advances Advance[]
  accountClosingBalances AccountClosingBalance[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  @@index([deletedAt])
  @@index([parentId])
  @@index([account_type])
}

enum PeriodStatus {
  Open
  Closed
  Locked
}

model AccountingPeriod {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  start_date DateTime     @db.Timestamptz
  end_date   DateTime     @db.Timestamptz
  status     PeriodStatus @default(Open)

  journalEntries JournalEntry[]
  closingBalances AccountClosingBalance[]

  closed_by String?   @db.Uuid
  closed_at DateTime? @db.Timestamptz

  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([start_date, end_date])
  @@index([status])
}

enum JournalEntryStatus {
  Draft
  Posted
  Voided
}

model JournalEntry {
  id         String             @id @default(uuid()) @db.Uuid
  ref_id     String?            @unique
  entry_date DateTime           @db.Timestamptz
  memo       String?            @db.Text
  status     JournalEntryStatus @default(Draft)

  periodId String           @db.Uuid
  period   AccountingPeriod @relation(fields: [periodId], references: [id])

  source_type String  @default("Manual")
  source_id   String? @db.Uuid

  reversalOfId String?       @unique @db.Uuid
  reversalOf   JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("JournalReversal")

  lines JournalLine[]
  invoices Invoice[]
  invoicePayments InvoicePayment[]
  bills Bill[]
  billPayments BillPayment[]
  advances Advance[]
  advanceApplications AdvanceApplication[]

  created_by String?   @db.Uuid
  posted_by  String?   @db.Uuid
  posted_at  DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  version    Int       @default(1)

  @@index([periodId])
  @@index([entry_date])
  @@index([status])
  @@index([source_type, source_id])
}

model JournalLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  debit       Decimal @default(0.0) @db.Decimal(12, 2)
  credit      Decimal @default(0.0) @db.Decimal(12, 2)
  currency    String  @default("SAR")
  description String?

  reconciled     Boolean             @default(false)
  reconciliationId String?           @db.Uuid
  reconciliation BankReconciliation? @relation(fields: [reconciliationId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([journalEntryId])
  @@index([accountId])
}

// -----------------------------------------
// INVOICE / ACCOUNTS RECEIVABLE
// -----------------------------------------

enum InvoiceStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
  Void
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  ref_id       String?       @unique
  customerId   String        @db.Uuid
  customer     Customer      @relation(fields: [customerId], references: [id])

  invoice_date DateTime      @db.Timestamptz
  due_date     DateTime?     @db.Timestamptz
  status       InvoiceStatus @default(Draft)

  subtotal     Decimal @default(0.0) @db.Decimal(12, 2)
  tax_rate     Decimal @default(0.0) @db.Decimal(5, 2)
  tax_amount   Decimal @default(0.0) @db.Decimal(12, 2)
  total_amount Decimal @default(0.0) @db.Decimal(12, 2)
  paid_amount  Decimal @default(0.0) @db.Decimal(12, 2)
  balance_due  Decimal @default(0.0) @db.Decimal(12, 2)
  currency     String  @default("SAR")

  lines    InvoiceLine[]
  payments InvoicePayment[]
  advanceApplications AdvanceApplication[]
  trips    Trip[]

  // Set when Issued: the AR/Revenue JournalEntry this invoice created.
  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Nullable: null for a manual/adjustment line not tied to a specific trip.
  tripId      String?  @db.Uuid
  trip        Trip?    @relation(fields: [tripId], references: [id])

  description String
  quantity    Float    @default(1)
  rate        Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([invoiceId])
  @@index([tripId])
}

model InvoicePayment {
  id             String       @id @default(uuid()) @db.Uuid
  invoiceId      String       @db.Uuid
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount         Decimal      @db.Decimal(12, 2)
  payment_date   DateTime     @db.Timestamptz
  payment_method String?
  reference      String?

  // The Bank/Cash Account that received the funds
  accountId      String       @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])

  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  created_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([invoiceId])
}

// -----------------------------------------
// 4B. BILL / ACCOUNTS PAYABLE
// -----------------------------------------

enum BillStatus {
  Draft
  Approved
  PartiallyPaid
  Paid
  Void
}

model Bill {
  id           String     @id @default(uuid()) @db.Uuid
  ref_id       String?    @unique
  providerId   String?    @db.Uuid
  provider     ThirdPartyProvider? @relation(fields: [providerId], references: [id])
  payee_name   String?

  bill_date    DateTime   @db.Timestamptz
  due_date     DateTime?  @db.Timestamptz
  status       BillStatus @default(Draft)

  subtotal     Decimal @default(0.0) @db.Decimal(12, 2)
  tax_amount   Decimal @default(0.0) @db.Decimal(12, 2)
  total_amount Decimal @default(0.0) @db.Decimal(12, 2)
  paid_amount  Decimal @default(0.0) @db.Decimal(12, 2)
  balance_due  Decimal @default(0.0) @db.Decimal(12, 2)
  currency     String  @default("SAR")

  lines    BillLine[]
  payments BillPayment[]
  advanceApplications AdvanceApplication[]

  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  created_by String?  @db.Uuid
  updated_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([providerId])
  @@index([status])
}

model BillLine {
  id        String  @id @default(uuid()) @db.Uuid
  billId    String  @db.Uuid
  bill      Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  // Polymorphic source: "Expense" + expense.id, "TripSubcontract" + subcontract.id, or "Manual"
  source_type String  @default("Manual")
  source_id   String? @db.Uuid

  // Expense-type GL account to debit when bill is approved
  accountId   String?  @db.Uuid
  account     Account? @relation(fields: [accountId], references: [id])

  description String
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([billId])
  @@index([source_type, source_id])
  @@index([accountId])
}

model BillPayment {
  id             String       @id @default(uuid()) @db.Uuid
  billId         String       @db.Uuid
  bill           Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)

  amount         Decimal      @db.Decimal(12, 2)
  payment_date   DateTime     @db.Timestamptz
  payment_method String?
  reference      String?

  accountId      String       @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])

  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  created_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([billId])
  @@index([accountId])
}

// -----------------------------------------
// CASH & BANK, ADVANCES & PERIOD CLOSING
// -----------------------------------------

model BankAccount {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @unique @db.Uuid
  account         Account  @relation(fields: [accountId], references: [id])

  bank_name       String?
  account_number  String?
  iban            String?
  swift_code      String?
  is_cash         Boolean  @default(false)
  opening_balance Decimal  @default(0.0) @db.Decimal(12, 2)
  opening_date    DateTime? @db.Timestamptz
  currency        String   @default("SAR")

  reconciliations BankReconciliation[]

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz

  @@index([deletedAt])
}

enum ReconciliationStatus {
  Draft
  Completed
}

model BankReconciliation {
  id                      String               @id @default(uuid()) @db.Uuid
  bankAccountId           String               @db.Uuid
  bankAccount             BankAccount          @relation(fields: [bankAccountId], references: [id])
  statement_date          DateTime             @db.Timestamptz
  statement_closing_balance Decimal            @db.Decimal(12, 2)
  status                  ReconciliationStatus @default(Draft)
  lines                   JournalLine[]

  reconciled_by String?   @db.Uuid
  reconciled_at DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz

  @@index([bankAccountId])
}

enum AdvancePartyType {
  Customer
  Provider
  Employee
}

enum AdvanceDirection {
  Received
  Paid
}

enum AdvanceStatus {
  Open
  PartiallyApplied
  FullyApplied
  Void
}

model Advance {
  id           String           @id @default(uuid()) @db.Uuid
  ref_id       String?          @unique
  party_type   AdvancePartyType
  party_id     String?          @db.Uuid
  direction    AdvanceDirection
  amount       Decimal          @db.Decimal(12, 2)
  applied_amount Decimal        @default(0.0) @db.Decimal(12, 2)
  remaining_amount Decimal      @db.Decimal(12, 2)
  advance_date DateTime         @db.Timestamptz
  status       AdvanceStatus    @default(Open)
  currency     String           @default("SAR")
  memo         String?          @db.Text

  accountId      String        @db.Uuid
  account        Account       @relation(fields: [accountId], references: [id])
  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  applications AdvanceApplication[]

  created_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([party_type, party_id])
  @@index([status])
}

model AdvanceApplication {
  id         String   @id @default(uuid()) @db.Uuid
  advanceId  String   @db.Uuid
  advance    Advance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  invoiceId  String?  @db.Uuid
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  billId     String?  @db.Uuid
  bill       Bill?    @relation(fields: [billId], references: [id])

  amount         Decimal       @db.Decimal(12, 2)
  applied_date   DateTime      @db.Timestamptz
  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  created_by String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([advanceId])
  @@index([invoiceId])
  @@index([billId])
}

model AccountClosingBalance {
  id         String   @id @default(uuid()) @db.Uuid
  periodId   String   @db.Uuid
  period     AccountingPeriod @relation(fields: [periodId], references: [id])
  accountId  String   @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id])

  closing_debit_total  Decimal @db.Decimal(14, 2)
  closing_credit_total Decimal @db.Decimal(14, 2)
  closing_balance      Decimal @db.Decimal(14, 2)
  computed_at          DateTime @default(now()) @db.Timestamptz

  @@unique([periodId, accountId])
  @@index([periodId])
}



// A place a lane starts or ends — Riyadh, Jeddah, Makkah, Madinah. Rate cards
// are priced between two of these, so they have to come from one shared list
// rather than whatever each user typed: "Madina" and "Madinah" as free text
// are two lanes that never match each other, or the rate card.
//
// slug is the lowercased, whitespace-collapsed name and carries the unique
// constraint, so the same place can't be entered twice under different casing.
// lat/lng are the default map pin for the place; a trip stop still stores its
// own exact coordinates, since "Riyadh" is a city and the dock is a point in it.
model Location {
  id                   String              @id @default(uuid()) @db.Uuid
  customerId           String              @db.Uuid
  customer             Customer            @relation(fields: [customerId], references: [id])
  code                 String
  name                 String
  slug                 String
  address              String?             @db.Text
  city                 String?
  postalCode           String?
  lat                  Float?
  lng                  Float?
  coordinate_precision CoordinatePrecision @default(UNKNOWN)

  is_active Boolean @default(true)

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  version    Int       @default(1)

  quotationStops               QuotationStop[]
  tripStops                    TripStop[]
  providerRateCardOrigins      ProviderRateCard[] @relation("ProviderRateOriginLocation")
  providerRateCardDestinations ProviderRateCard[] @relation("ProviderRateDestinationLocation")

  @@unique([customerId, code])
  @@unique([customerId, slug])
  @@index([customerId])
  @@index([deletedAt])
}

// -----------------------------------------
// 9. DEPLOYMENT SETTINGS (Branding & Modules)
// -----------------------------------------
// Singleton: this app is deployed once per client (separate VPS, separate
// database per client — see PROGRESS.md), so a single database only ever
// needs one Settings row. Not a per-user or per-org table; there is no
// tenant concept in this schema and none is needed.
model Settings {
  id String @id @default("singleton")

  appName          String  @default("MERCON Operator Platform")
  companyLegalName String  @default("MERCON Operations Ltd.")
  vatNumber        String?
  crNumber         String?
  logoUrl          String?
  primaryColor     String  @default("#E8450F")

  // IANA timezone this deployment displays dates/times in (e.g. "Asia/Riyadh").
  // Storage stays UTC everywhere (every DateTime column is @db.Timestamptz) —
  // this only controls conversion at the display/input edge in the frontends.
  timezone String @default("Asia/Riyadh")

  // Default country code and dial code for phone inputs and displays across the deployment.
  defaultCountryCode     String @default("SA")
  defaultCountryDialCode String @default("+966")

  // Base currency for accounting
  baseCurrency String @default("SAR")

  // Default General Ledger Accounts for AR Invoicing & AP Billing
  defaultReceivableAccountId String? @db.Uuid
  defaultRevenueAccountId    String? @db.Uuid
  defaultPayableAccountId   String? @db.Uuid
  defaultCustomerAdvanceAccountId String? @db.Uuid
  defaultProviderAdvanceAccountId String? @db.Uuid
  defaultEmployeeAdvanceAccountId String? @db.Uuid
  defaultRetainedEarningsAccountId String? @db.Uuid

  // Module keys this deployment shows/allows.
  enabledModules        String[] @default([])
  hiddenModules         String[] @default([])
  defaultRedirectModule String?  @default("quotations")

  // Theme palette and custom status colors for UI branding customization
  themeColors Json?

  // Vendor taxonomy registers (Vehicle classes, line types, billing types, master tags)
  taxonomyConfig Json?

  // Maintenance mode and global system status banner
  maintenanceMode   Boolean @default(false)
  maintenanceBanner String?

  updated_by String?  @db.Uuid
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz
}

// -----------------------------------------
// 8. SYSTEM ALERTS (Notifications)
// -----------------------------------------
model Notification {
  id       String  @id @default(uuid()) @db.Uuid
  // Recipient is either a User (web: admin/operator) or a Driver (mobile). Exactly one is set.
  userId   String? @db.Uuid
  user     User?   @relation(fields: [userId], references: [id])
  driverId String? @db.Uuid
  driver   Driver? @relation(fields: [driverId], references: [id])

  title       String
  message     String  @db.Text
  type        String // "Emergency", "Trip", "Document", "System"
  is_read     Boolean @default(false)
  entity_type String? // "Trip", "Driver", "Vehicle"
  entity_id   String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz

  // The dashboard bell and the driver app both read the 50 newest for one
  // recipient; neither column was indexed.
  @@index([userId, createdAt])
  @@index([driverId, createdAt])
}

model DriverDevice {
  id         String   @id @default(uuid()) @db.Uuid
  driverId   String   @db.Uuid
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([driverId, isActive])
  @@map("driver_devices")
}

// -----------------------------------------
// 9. COMPANY EXCEL REPORT TEMPLATES
// -----------------------------------------
// A customer-supplied .xlsx (their own branded trip-report layout) plus the
// human-confirmed column mapping used to fill it. The file's bytes live in
// Postgres, not on disk — the deploy's only durable volume is pgdata (see
// docker-compose.yml), and templates are small, precious configuration that
// should ride along with the database rather than a bind-mounted /tmp.
model ReportTemplate {
  id     String @id @default(uuid()) @db.Uuid
  name   String
  source String @default("trips") // room for invoices/expenses later

  customerId String?   @db.Uuid // null = shared/global template
  customer   Customer? @relation(fields: [customerId], references: [id])

  original_filename String
  file_data         Bytes // the uploaded .xlsx, unmodified
  file_size         Int
  layout            Json   @db.JsonB // TemplateLayout (@mercon/shared-types) — confirmed mapping

  created_by String?   @db.Uuid
  updated_by String?   @db.Uuid
  deleted_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  isActive   Boolean   @default(true)
  version    Int       @default(1)

  @@index([customerId])
}

// -----------------------------------------
// 10. SMART REPORT BUILDER
// -----------------------------------------
// A saved report is a serialized ReportQuerySpec (module/fields/filters/
// aggregations chosen in the builder), not a materialized result — it is
// re-run against live data every time it's opened.
model SavedReport {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  category      String // 'Operations' | 'Drivers' | 'Vehicles' | 'Finance' | 'Customers' | 'Custom'
  spec          Json    @db.JsonB
  visualization String  @default("table")
  isTemplate    Boolean @default(false)

  scheduledReports ScheduledReport[]

  created_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz
  version    Int       @default(1)

  @@index([deletedAt])
  @@index([category])
}

model ScheduledReport {
  id            String      @id @default(uuid()) @db.Uuid
  savedReportId String      @db.Uuid
  savedReport   SavedReport @relation(fields: [savedReportId], references: [id])

  frequency  String // 'daily' | 'weekly' | 'monthly'
  dayOfMonth Int?
  time       String // 'HH:mm'
  recipients String[]
  delivery   String[] // ['email','dashboard','pdf','excel']
  isActive   Boolean  @default(true)

  created_by String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz
  deletedAt  DateTime? @db.Timestamptz

  @@index([savedReportId])
  @@index([deletedAt])
}

// -----------------------------------------
// 11. AUDIT LOGGING ENGINE
// -----------------------------------------
// Records sensitive operations (role changes, credential resets, account activation/deactivation/deletion, SuperAdmin operations).
// STRICT SECURITY RULE: Passwords, PINs, tokens, and raw secrets are NEVER logged in metadata or text.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "USER_ROLE_UPDATED", "DRIVER_PIN_RESET", "USER_DEACTIVATED", "USER_DELETED"
  entityType String // e.g. "User", "Driver", "Trip", "Quotation"
  entityId   String?
  metadata   Json?    @db.JsonB // Context metadata (IP address, user-agent, affected fields - NO SECRETS)
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Aggregated, deduplicated application error events (backend + web dashboard).
// Populated automatically from logger.error/fatal calls via a pino hook
// (utils/logger.ts) and from the web dashboard's ErrorBoundary/window.onerror
// (POST /api/client-errors) — see utils/errors.ts and services/errorCapture.ts.
model ErrorEvent {
  id            String   @id @default(uuid()) @db.Uuid
  fingerprint   String   @unique
  code          String
  message       String
  stack         String?  @db.Text
  route         String
  source        String // 'api' | 'web'
  count         Int      @default(1)
  status        String   @default("New") // New | Acknowledged | Resolved
  lastRequestId String?
  firstUserId   String?  @db.Uuid
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  @@index([status])
  @@index([source])
  @@index([updatedAt])
  @@map("error_events")
}

// -----------------------------------------
// 22. MASTER DATA TAXONOMY & VEHICLE COMPATIBILITY
// -----------------------------------------
model VehicleCompatibilityRule {
  id                         String   @id @default(uuid()) @db.Uuid
  serviceVehicleClassId      String
  serviceVehicleClassCode    String   @unique
  preferredVehicleClassCodes String[]
  allowedVehicleClassCodes   String[]
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now()) @db.Timestamptz
  updatedAt                  DateTime @default(now()) @updatedAt @db.Timestamptz

  @@index([serviceVehicleClassCode])
}
